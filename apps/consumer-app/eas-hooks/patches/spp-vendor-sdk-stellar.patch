+fn is_transient_reqwest_error(error: &reqwest::Error) -> bool {
+    // A DNS/name-resolution failure is deterministic for this request. Do not
+    // spend the full retry budget on it: every RPC page would otherwise add
+    // another 30s request window and make the UI appear stuck for minutes.
+    if error.is_connect() {
+        let message = error.to_string().to_ascii_lowercase();
+        if message.contains("dns error")
+            || message.contains("failed to look up address")
+            || message.contains("no address associated with hostname")
+            || message.contains("name or service not known")
+            || message.contains("nodename nor servname provided")
+        {
+            return false;
+        }
+    }
+
+    error.is_timeout()
+        || error.is_connect()
+        || error.is_body()
+        || error.is_decode()
+        || error
+            .status()
+            .is_some_and(|status| status.as_u16() == 429 || status.is_server_error())
+}
