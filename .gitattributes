# Enforce consistent line endings across the monorepo.
# All text files are normalised to LF in the repo; OS-native on checkout.
* text=auto

# Source code — always LF
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.json text eol=lf
*.css text eol=lf
*.md text eol=lf
*.yaml text eol=lf
*.yml text eol=lf

# Shell scripts — always LF
*.sh text eol=lf

# Windows batch files — always CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files — no line ending conversion
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.ttf binary
*.woff binary
*.woff2 binary
