{
  "name": "consumer-app",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start --dev-client",
    "start:go": "expo start --go",
    "android": "set NODE_ENV=development&& expo run:android",
    "android:emulator": "set NODE_ENV=development&& powershell -ExecutionPolicy Bypass -File ./scripts/run-android-emulator.ps1",
    "android:build": "cd android && gradlew.bat assembleDebug --no-daemon",
    "android:tasks:safe": "set NODE_ENV=development&& set GRADLE_USER_HOME=D:\\g&& cd android && gradlew.bat --stop && gradlew.bat :app:tasks --all --no-daemon",
    "android:build:safe": "set NODE_ENV=development&& powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/build-android-safe.ps1",
    "android:clean:native": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"Get-ChildItem -Path node_modules -Directory -Recurse -Filter .cxx -ErrorAction SilentlyContinue | Remove-Item -Recurse -Force -ErrorAction SilentlyContinue; Remove-Item -Recurse -Force android/app/.cxx -ErrorAction SilentlyContinue; Remove-Item -Recurse -Force android/app/build/intermediates/cxx -ErrorAction SilentlyContinue\"",
    "android:build:emulator": "set NODE_ENV=development&& powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/build-android-emulator-safe.ps1",
    "android:app-links:verify": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/verify-app-links.ps1 -OpenIntents",
    "android:app-links:assetlinks": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/generate-assetlinks-json.ps1",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "jest",
    "test:watch": "jest --watch"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo-google-fonts/jetbrains-mono": "^0.4.1",
    "@expo-google-fonts/manrope": "^0.4.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "11.5.2",
    "@react-navigation/native": "^7.1.34",
    "@react-navigation/native-stack": "^7.14.6",
    "@sentry/react-native": "~7.11.0",
    "@shopify/flash-list": "2.0.2",
    "@walletconnect/sign-client": "^2.23.9",
    "ethers": "^6.16.0",
    "expo": "~55.0.17",
    "expo-application": "~55.0.14",
    "expo-camera": "~55.0.18",
    "expo-clipboard": "~55.0.13",
    "expo-constants": "~55.0.11",
    "expo-crypto": "~55.0.14",
    "expo-device": "~55.0.16",
    "expo-font": "~55.0.6",
    "expo-haptics": "~55.0.14",
    "expo-local-authentication": "~55.0.13",
    "expo-notifications": "~55.0.22",
    "expo-secure-store": "~55.0.13",
    "expo-status-bar": "~55.0.6",
    "expo-updates": "~55.0.21",
    "mixpanel-react-native": "^3.3.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.6",
    "react-native-get-random-values": "~1.11.0",
    "react-native-qrcode-svg": "^6.3.21",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-svg": "15.15.3",
    "react-native-web": "^0.21.0",
    "react-native-webview": "13.16.0",
    "react-native-worklets": "0.7.4",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.10",
    "babel-plugin-transform-remove-console": "^6.9.4",
    "jest": "^29.7.0",
    "jest-expo": "~55.0.17",
    "react-test-renderer": "19.2.0",
    "typescript": "~5.9.2"
  },
  "private": true
}
