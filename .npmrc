# Flatten node_modules (npm-style hoisted layout). Required for local Windows
# Android APK builds — ninja/cmake paths must stay under MAX_PATH — and committed
# so CI installs the exact layout every local verification (tests, typechecks)
# ran against. The isolated pnpm layout previously made CI fail on imports that
# resolve only through hoisting (expo-asset, expo-modules-core, etc.).
node-linker=hoisted
