{
  "cli": {
    "version": ">= 5.0.0"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "sentry": {
        "organization": "veilpay",
        "project": "consumer-app",
        "authTokenEnvVar": "SENTRY_AUTH_TOKEN"
      }
    },
    "production": {
      "android": {
        "buildType": "app-bundle"
      },
      "sentry": {
        "organization": "veilpay",
        "project": "consumer-app",
        "authTokenEnvVar": "SENTRY_AUTH_TOKEN"
      }
    }
  }
}
