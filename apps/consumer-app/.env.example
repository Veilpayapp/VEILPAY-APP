# Veilpay consumer-app environment variables
# Copy this file to .env and fill in real values.

# Set ONE of these base URLs:
# - EXPO_PUBLIC_INDEXER_BASE_URL: preferred read/indexer API base
# - EXPO_PUBLIC_BACKEND_BASE_URL: fallback backend API base
EXPO_PUBLIC_INDEXER_BASE_URL=http://10.0.2.2:3000
EXPO_PUBLIC_BACKEND_BASE_URL=http://10.0.2.2:3000

# Sentry DSN for production crash reporting
# Example: https://<key>@o0.ingest.sentry.io/<project>
EXPO_PUBLIC_SENTRY_DSN=

# WalletConnect Cloud project ID (required to generate WalletConnect v2 session URIs)
# Create one at https://cloud.walletconnect.com and paste it here.
EXPO_PUBLIC_WALLETCONNECT_PROJECT_ID=

# EAS project metadata used by app.config.js
# EXPO_PUBLIC_EAS_PROJECT_ID should be the UUID shown by eas project:info
EXPO_PUBLIC_EAS_PROJECT_ID=

# Optional OTA update URL, usually https://u.expo.dev/<project-id>
EXPO_PUBLIC_EAS_UPDATE_URL=

# Analytics controls (optional)
# Set EXPO_PUBLIC_ENABLE_ANALYTICS=true to allow analytics tracking.
# Mixpanel tracking only starts when both analytics consent and token are present.
EXPO_PUBLIC_ENABLE_ANALYTICS=false
EXPO_PUBLIC_MIXPANEL_TOKEN=

# Feature flags (optional)
# Keep false in most dev/staging environments unless explicitly testing these flows.
EXPO_PUBLIC_ENABLE_MAINNET_TRANSACTIONS=false
EXPO_PUBLIC_DEMO_WALLET_CONNECT=false

# Play Integrity app attestation (Hardening #2)
# When true, onramp/RPC-proxy calls carry a Play Integrity token (requires the
# integrity-native module linked + backend PLAY_INTEGRITY_* config). Keep false
# during rollout; the backend fail-closes these endpoints in production until
# wired, and the two flags must be flipped together per environment.
EXPO_PUBLIC_PLAY_INTEGRITY_ENABLED=false

# SSL public-key pinning (release APK/IPA fail-closed if missing or init fails)
# JSON: {"api.veilpay.app":["<spki-sha256-base64>"]} — never use dummy AAAA…= hashes
# EXPO_PUBLIC_SSL_PINS=

# Push registration path is fixed to:
# /api/v1/notifications/register-device

# Optional: path used for transaction history endpoint
# Defaults to /api/v1/transactions if omitted
EXPO_PUBLIC_INDEXER_HISTORY_PATH=/api/v1/transactions



# ---- Chain-specific RPC Overrides (optional — leave blank to use pool defaults) ----
# EXPO_PUBLIC_RPC_ETHEREUM=https://eth-mainnet.g.alchemy.com/v2/<YOUR_KEY>
# EXPO_PUBLIC_RPC_POLYGON=https://polygon-mainnet.g.alchemy.com/v2/<YOUR_KEY>
# EXPO_PUBLIC_RPC_ARBITRUM=https://arb-mainnet.g.alchemy.com/v2/<YOUR_KEY>
# EXPO_PUBLIC_RPC_SEPOLIA=https://eth-sepolia.g.alchemy.com/v2/<YOUR_KEY>
# EXPO_PUBLIC_RPC_SOLANA=https://solana-mainnet.g.alchemy.com/v2/<YOUR_KEY>
EXPO_PUBLIC_RPC_SOLANA_DEVNET=https://api.devnet.solana.com

# Transak API Key - Get yours from https://dashboard.transak.com
# For testing use 'staging' key, for prod use 'production' key
EXPO_PUBLIC_TRANSAK_API_KEY=

# Transak Environment: STAGING or PRODUCTION
EXPO_PUBLIC_TRANSAK_ENV=STAGING

# Transak referrer domain used by the embedded widget
# Defaults to veilpay.app in code, but override this if your production domain differs.
EXPO_PUBLIC_TRANSAK_REFERRER_DOMAIN=veilpay.app

# ---- Groth16 circuit artifacts for the "max privacy" proof path -------------------------------------------
# The WebView downloads snarkjs + the circuit WASM/ZKEY at proof time. All three
# are integrity-checked to prevent a tampered/MITM'd artifact from exfiltrating
# the private witness. assertCircuitConfigured() FAILS CLOSED (CIRCUIT_NOT_CONFIGURED)
# if the URLs OR the SHA-256 pins are unset, so supply all four in any build that
# offers the max-privacy flow. Compute the digests from your compile.sh output:
#   sha256sum withdraw.wasm         # -> EXPO_PUBLIC_CIRCUIT_WASM_SHA256
#   sha256sum withdraw_final.zkey   # -> EXPO_PUBLIC_CIRCUIT_ZKEY_SHA256
# EXPO_PUBLIC_CIRCUIT_WASM_URL=<https://your-cdn/withdraw.wasm>
# EXPO_PUBLIC_CIRCUIT_ZKEY_URL=<https://your-cdn/withdraw_final.zkey>
# EXPO_PUBLIC_CIRCUIT_WASM_SHA256=<hex>
# EXPO_PUBLIC_CIRCUIT_ZKEY_SHA256=<hex>
# Optional SRI for the snarkjs UMD (sha384-base64), enforced by the WebView:
# EXPO_PUBLIC_SNARKJS_SRI=sha384-<base64>
