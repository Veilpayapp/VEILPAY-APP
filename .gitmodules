[submodule "packages/contracts-evm/lib/openzeppelin-contracts"]
	path = packages/contracts-evm/lib/openzeppelin-contracts
	url = https://github.com/OpenZeppelin/openzeppelin-contracts
[submodule "packages/contracts-evm/lib/forge-std"]
	path = packages/contracts-evm/lib/forge-std
	url = https://github.com/foundry-rs/forge-std
[submodule "packages/vendor/spp"]
	path = packages/vendor/spp
	url = https://github.com/NethermindEth/stellar-private-payments
