# ============================================================
# VeilPay — Complete Environment Variable Reference
# ============================================================
# Copy this file to .env (backend) or .env.local (consumer-app)
# ALL values below are placeholders — never commit real secrets.
# Production: ALL real values are managed by Doppler.
# https://doppler.com/docs/enclave-vs-syncing
# ============================================================

# ================================================================
# BACKEND (apps/backend/.env)
# ================================================================

# ---- Database & Cache ----
DATABASE_URL="postgresql://veilpay:CHANGE_ME@localhost:5432/veilpay"
# Direct (non-pooled) postgres connection string for `prisma migrate`.
# apps/backend/prisma/schema.prisma requires it (directUrl) — migrations
# must NOT go through a connection pooler (e.g. PgBouncer/transaction mode).
DIRECT_URL="postgresql://veilpay:CHANGE_ME@localhost:5432/veilpay"
REDIS_URL="redis://localhost:6379"
REDIS_PASSWORD=""                          # Required in production

# ---- Security ----
# Generate with: openssl rand -hex 32
JWT_SECRET=""                              # min 32 chars — REQUIRED
API_KEY_SALT=""                            # min 16 chars — REQUIRED
WEBHOOK_SIGNING_SECRET=""                  # min 32 chars — REQUIRED (separate from above)

# ---- Merchant Tiers ----
DEFAULT_MERCHANT_TIER="basic"             # basic | pro | enterprise

# ---- Server ----
NODE_ENV="development"                    # development | test | production
PORT="3001"
# Number of trusted reverse-proxy hops in front of the backend;
# see apps/backend/src/config/index.ts (set 1 for a single load balancer).
TRUST_PROXY_HOPS="0"

# ---- CORS (comma-separated origins; never use * in production) ----
CORS_ORIGINS="http://localhost:3000,http://localhost:8081"

# ---- RPC Provider API Keys (Doppler injects these in production) ----
# Free-tier signup:
#   Alchemy  → https://www.alchemy.com  (300M CU/month)
#   Infura   → https://infura.io        (100K req/day)
# Production: at least one of Alchemy or Infura is REQUIRED (backend boot fails closed).
ALCHEMY_API_KEY=""
INFURA_API_KEY=""

# GoldRush / Covalent — non-EVM invoice confirm + chain indexer (Solana, etc.)
# Stellar uses Horizon directly (no GoldRush slug).
GOLDRUSH_API_KEY=""

# Payment confirm: minimum EVM receipt confirmations (default 1)
PAYMENT_MIN_CONFIRMATIONS="1"

# Relayer — REQUIRED in production for /relayer withdraw (X-Relayer-Secret)
RELAYER_SHARED_SECRET=""
RELAYER_PRIVATE_KEY=""
RELAYER_RPC_URL=""
# Optional risk caps (0 = unlimited where code allows sentinel)
# MAX_WITHDRAW_AMOUNT / RELAYER_MAX_WITHDRAW_AMOUNT — see contracts + relayer env

# ---- RPC Endpoints (backend indexer) ----
RPC_ETHEREUM="https://eth.llamarpc.com"
RPC_POLYGON="https://polygon.llamarpc.com"
RPC_ARBITRUM="https://arb1.arbitrum.io/rpc"
RPC_BASE="https://mainnet.base.org"
RPC_SOLANA="https://api.mainnet-beta.solana.com"
RPC_SOLANA_DEVNET="https://api.devnet.solana.com"

# ---- Error Monitoring ----
# REQUIRED in production for BOTH the backend and the indexer — each fails
# closed at boot when it is empty (apps/backend/src/config/index.ts,
# apps/indexer/src/config/index.ts). Get a DSN at https://sentry.io.
SENTRY_DSN=""

# ---- Indexer Feature Flags ----
INDEX_SOLANA=false
# Periodic settlement drift check interval in ms (0 = OFF, the default).
# When > 0, the indexer runs a read-only payments↔invoices drift comparison
# plus undelivered-webhook reporting on that cadence.
# See docs/reference/settlement-reconciliation.md.
RECONCILIATION_DRIFT_CHECK_INTERVAL_MS=0

# ================================================================
# CONSUMER APP (apps/consumer-app/.env.local)
# Only EXPO_PUBLIC_* vars are bundled into the app binary.
# Never put secrets in EXPO_PUBLIC_* vars.
# ================================================================

# ---- API Endpoints ----
EXPO_PUBLIC_BACKEND_BASE_URL="http://localhost:3001"
EXPO_PUBLIC_INDEXER_BASE_URL=""
EXPO_PUBLIC_INDEXER_HISTORY_PATH="/api/v1/transactions"

# ---- RPC Endpoints ----
# All blockchain RPC calls are proxied through the backend (/api/v1/rpc/:chain).
# The backend holds Alchemy/Infura keys via Doppler — never expose them on the client.
# The overrides below are optional and only for dev/testing.

# ---- Chain-specific RPC Overrides (optional) ----
EXPO_PUBLIC_RPC_ETHEREUM=""
EXPO_PUBLIC_RPC_POLYGON=""
EXPO_PUBLIC_RPC_ARBITRUM=""
EXPO_PUBLIC_RPC_BASE=""                   # Base L2 (Coinbase) — chainId 8453
EXPO_PUBLIC_RPC_SEPOLIA=""
EXPO_PUBLIC_RPC_SOLANA=""
EXPO_PUBLIC_RPC_SOLANA_DEVNET="https://api.devnet.solana.com"

# ---- WalletConnect ----
EXPO_PUBLIC_WALLETCONNECT_PROJECT_ID=""   # https://cloud.walletconnect.com

# ---- Analytics (opt-in) ----
EXPO_PUBLIC_ENABLE_ANALYTICS="false"
EXPO_PUBLIC_MIXPANEL_TOKEN=""

# ---- Feature Flags ----
EXPO_PUBLIC_ENABLE_MAINNET_TRANSACTIONS="false"  # Set true only after full audit

# ---- SSL public-key pinning (release builds REQUIRE real pins) ----
# JSON map host → array of SPKI sha256/base64 hashes. Dummy AAAA…= pins are rejected.
# Generate SPKI hash (openssl):
#   openssl s_client -connect api.example.com:443 </dev/null 2>/dev/null \
#     | openssl x509 -pubkey -noout \
#     | openssl pkey -pubin -outform der \
#     | openssl dgst -sha256 -binary | openssl enc -base64
# Example (replace with real hashes before release):
# EXPO_PUBLIC_SSL_PINS={"api.veilpay.app":["BASE64_SPKI_SHA256_HERE="]}
EXPO_PUBLIC_SSL_PINS=""

# ---- Error Monitoring ----
EXPO_PUBLIC_SENTRY_DSN=""

# ---- EAS Build (project identity) ----
# OTA/EAS Update channels are RETIRED: expo-updates is disabled in
# app.config.js (updates.enabled: false, checkAutomatically: 'NEVER') and
# eas.json is marked deprecated. App releases ship through store/APK builds.
# This var is still read at runtime by src/utils/envValidation.ts (build
# identity warning) — keep it set for EAS Build.
EXPO_PUBLIC_EAS_PROJECT_ID="b083fea1-cac0-4e6c-a07d-81ec0417cf36"

# ---- Doppler build-secret injection ----
# DOPPLER_TOKEN is NOT stored in this file. If Doppler injection is wired
# into cloud builds, the token is stored as an EAS Secret:
#   eas secret:create --scope project --name DOPPLER_TOKEN --value <token>
# <!-- LEAD-PATCH: do not re-add claims about a preInstallHook in eas.json —
#      no such hook exists in the current eas.json. Final build-time secret
#      wiring is being decided at integration. -->
# Optional Doppler project/config overrides (defaults shown):
# DOPPLER_PROJECT="veilpay-consumer-app"
# DOPPLER_CONFIG="prd"
